# 复制为 .env，填写密钥；.env 不进入 Git。
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOOL_ROUNDS=50
LLM_TIMEOUT=120
SHELL_TIMEOUT=30

# DDS Grounding DINO 云服务
DDS_API_TOKEN=your-dds-token
DDS_BASE_URL=https://api.deepdataspace.com

# 1 启用 / 0 关闭。保持现有硬件启动行为；纯文字可用 --no-hardware --text-only。
ENABLE_ARM=1
ENABLE_CAMERA=1
ENABLE_VISION=1
ENABLE_VOICE=1
ARM_AUTO_START=1
CAM_AUTO_START=1

# 退出时先检查 / 收拢到驱动配置的 Sleep，再清理当前设备的相关进程。
# Sleep 动作等待上限（秒）和实际关节到位容差（弧度）。
SHUTDOWN_SLEEP_TIMEOUT=30
SLEEP_JOINT_TOLERANCE=0.03

# MoveIt 规划/轨迹执行的速度比例与总超时（秒）。
ARM_VELOCITY_SCALING=0.25
ARM_MOTION_TIMEOUT=45

# 本机 ROS / 现有控制器。路径支持 ~ 和环境变量。
ROS_SETUP=/opt/ros/humble/setup.bash
WS_SETUP=~/interbotix_ws/install/setup.bash
CONTROLLER_DIR=~/interbotix_ws/controller
ROS_PYTHON=/usr/bin/python3
VISION_PYTHON=~/miniconda3/envs/graspnet/bin/python
# 默认使用启动 CLI 的 Python；ASR 在另一个环境时取消注释。
# ASR_PYTHON=~/miniconda3/envs/my_agent/bin/python
SAM2_SERVER=~/msk_tool/sam2_server.py
CALIBRATION=~/interbotix_ws/biaoding/calibration_result.json
WORKSPACE_MASK=~/msk_tool/masks/current_workspace.png
SCENE_DIR=/tmp/my_agent_scenes
ROBOT_NAME=wx250s
CAMERA_PREFIX=/camera/camera

# 场景超过该秒数需要重扫。抓取候选最低分数范围 0~1。
SCENE_MAX_AGE=300
GRASP_SCORE_MIN=0
MIC_DEVICE=plughw:1,0
TTS_VOICE=zh-CN-YunxiNeural
