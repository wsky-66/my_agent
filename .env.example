# 复制为 .env 并填入你的配置
LLM_API_KEY=sk-your-key

# deepseek（多模态用 deepseek-v4-flash-vision-exp）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash-vision-exp

# openai 示例
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

LLM_MAX_TOOL_ROUNDS=25
SHELL_TIMEOUT=30

# DDS 算法平台（Grounding DINO 开放集检测）
DDS_API_TOKEN=your-dds-token
DDS_BASE_URL=https://api.deepdataspace.com

# 启动时自动拉起机器人 / 相机（1 开 0 关）
ARM_AUTO_START=1
CAM_AUTO_START=1
